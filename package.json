{
  "name": "echora-cloud",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev:site": "vite --host 127.0.0.1 --port 8787",
    "dev": "npm run build && wrangler dev",
    "preview": "vite preview --host 127.0.0.1 --port 8787",
    "deploy": "npm run build && wrangler deploy",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc -p site/tsconfig.json --noEmit"
  },
  "dependencies": {
    "lucide": "^0.468.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260719.1",
    "typescript": "^5.8.3",
    "vite": "^6.4.3",
    "vitest": "^4.1.10",
    "wrangler": "^4.25.0"
  }
}

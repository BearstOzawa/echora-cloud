{
  "name": "echora-cloud",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev:site": "vite",
    "dev": "npm run build && wrangler dev",
    "preview": "vite preview --host 127.0.0.1 --port 8787",
    "deploy": "npm run build && wrangler deploy",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc -p site/tsconfig.json --noEmit",
    "deployment:register": "node scripts/register-cloud-deployment.mjs"
  },
  "dependencies": {
    "js-md5": "^0.9.2",
    "lucide": "^0.577.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260822.1",
    "@types/node": "^22.20.1",
    "typescript": "^5.8.3",
    "vite": "^6.4.3",
    "vitest": "^4.1.11",
    "wrangler": "^4.125.0"
  }
}

{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "echora-cloud",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-20",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/health", "/v1/*", "/help/install/ios"]
  },
  "vars": {
    "ALLOWED_ORIGIN": "*",
    "GITHUB_CACHE_SECONDS": "600"
  },
  "observability": {
    "enabled": true
  }
}
